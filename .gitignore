# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google service-account credentials
/rugged-truck-494019-g8-189de82ed26f.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# opencode
.agents/
skills-lock.json

# root-level images (source files belong in public/) — anchored to repo
# root only; an unanchored pattern here would also match, and silently
# drop, real assets under public/assets/**
/*.png
/*.svg

# temp files
/temp

# claude code local settings (per-developer, not shared)
.claude/settings.local.json

# playwright-cli debug artifacts
/.playwright-cli/

# graphify knowledge-graph output (generated, not project source)
/graphify-out/
